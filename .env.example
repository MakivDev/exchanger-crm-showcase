# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=crm_for_exchanger
POSTGRES_PORT=5432
APP_PORT=3000

# HTTP без SSL (типово VPS за IP:3000) — обовʼязково false, інакше вхід не зберігається
COOKIE_SECURE=false
# Після HTTPS (Caddy): COOKIE_SECURE=true та APP_URL=https://your-domain.com

# APP_URL=https://crm.example.com

# Домен для Caddy (docker-compose.caddy.yml). Порожньо = лише IP:3000
# Після DNS A → IP сервера: ./scripts/vps-enable-https.sh your-domain.com
# DOMAIN=your-domain.com

# Імʼя docker compose проєкту
COMPOSE_PROJECT_NAME=crm-for-exchanger

# Prisma / локальні інструменти (у Docker app/migrate DATABASE_URL збирається сам)
DATABASE_URL=postgresql://crm:change_me_strong_password@localhost:5432/crm_for_exchanger?schema=public

# Auth cookie
SESSION_COOKIE_NAME=crm_session

# Seed admin (змініть після першого входу)
SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Адмін

NODE_ENV=production
